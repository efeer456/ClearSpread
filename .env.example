# Alpaca paper trading keys (dashboard -> Paper Trading -> API Keys)
ALPACA_API_KEY=your_alpaca_paper_key
ALPACA_SECRET_KEY=your_alpaca_paper_secret

# Gemini API key (aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_key
# Optional. Gemini's free tier counts its daily request quota PER MODEL, and one
# signal costs 4 agent calls, so the app falls through this list on a quota (429)
# or model-unavailable (404) error instead of failing the whole analysis.
GEMINI_MODEL=gemini-3.7-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.6-flash

# SEC EDGAR's fair-access policy requires a real contact string
SEC_EDGAR_USER_AGENT="YourName YourApp your_email@example.com"

# Tickers offered in the UI dropdown (comma-separated)
WATCHLIST=AAPL,TSLA,NVDA

# Path to the Alpaca CLI binary (https://github.com/alpacahq/cli).
# If it is on your PATH, "alpaca" is enough; otherwise give the full path
# (e.g. on Windows, drop the downloaded exe at bin/alpaca.exe and point here).
ALPACA_CLI_PATH=alpaca
