# Alpaca paper trading anahtarları (dashboard -> Paper Trading -> API Keys)
ALPACA_API_KEY=your_alpaca_paper_key
ALPACA_SECRET_KEY=your_alpaca_paper_secret

# Gemini API anahtari (aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_key

# SEC EDGAR fair-access policy geregi gercek bir iletisim bilgisi istiyor
SEC_EDGAR_USER_AGENT="YourName YourApp your_email@example.com"

# Izlenecek hisseler (virgulle ayirin)
WATCHLIST=AAPL,TSLA,NVDA

# Alpaca CLI (https://github.com/alpacahq/cli) binary yolu.
# PATH'e ekliyse sadece "alpaca" yeterli; degilse tam yolu verin
# (orn. Windows'ta indirilen exe'yi bin/alpaca.exe altina koyup buraya yazabilirsiniz).
ALPACA_CLI_PATH=alpaca
